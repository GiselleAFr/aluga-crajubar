APP_NAME="Aluga Crajubar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
#DB_PORT=5433
#Caso esteja dando problema de conexão com o Banco
#Tente trocar a porta aqui e em docker-compose.yml
DB_DATABASE=aluga_crajubar
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail. Padrão de desenvolvimento: MAIL_MAILER=log (nada é enviado; o e-mail fica em storage/logs/laravel.log).
# Para envio real, use MAIL_MAILER=smtp e preencha host, porta, usuário e senha do provedor
# (veja a seção "Envio real de e-mails" do README). Nunca coloque credenciais reais neste arquivo.
# Gmail:   MAIL_HOST=smtp.gmail.com        MAIL_PORT=587  (senha de app; MAIL_FROM_ADDRESS = o próprio Gmail)
# Brevo:   MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  (login SMTP e chave SMTP do painel)
# Mailtrap (caixa de testes, não entrega de verdade): MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
# Porta 465: use também MAIL_SCHEME=smtps.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Link aberto pelo botão "Esqueceu a senha?" no Flutter.
MOBILE_RESET_PASSWORD_URL="alugacrajubar://reset-password"
# Página https deste back-end que abre o app (ex.: https://seu-dominio/reset-password).
# Em branco = o e-mail usa direto o deep link acima (nem todo cliente de e-mail o abre).
PASSWORD_RESET_WEB_URL=
MOBILE_CONFIRM_PASSWORD_CHANGE_URL="alugacrajubar://confirm-password-change"
JWT_SECRET=
JWT_TTL=60
PASSWORD_CHANGE_TTL=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SEED_TEST_PHONE=88999999999
SEED_HISTORY_EMAIL=seu-email@exemplo.com