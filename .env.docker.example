# =============================================================
#  Ambiente Docker do AlugaCrajubar (local)
#  1) Copie:   Copy-Item .env.docker.example .env.docker
#  2) Gere APP_KEY e JWT_SECRET (veja o README)
#  NUNCA faça commit do .env.docker
# =============================================================

# ===== Banco (lido pelos containers do Postgres) =====
POSTGRES_DB=aluga_crajubar
POSTGRES_USER=aluga
POSTGRES_PASSWORD=aluga_local_123
REPLICATION_PASSWORD=replica_local_123

# ===== Laravel =====
APP_NAME="Aluga Crajubar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# master = escrita | slave = leitura (nomes dos serviços no docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=master
DB_WRITE_HOST=master
DB_READ_HOST=slave
DB_PORT=5432
DB_DATABASE=aluga_crajubar
DB_USERNAME=aluga
# Precisa ser igual a POSTGRES_PASSWORD
DB_PASSWORD=aluga_local_123

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

MOBILE_RESET_PASSWORD_URL="alugacrajubar://reset-password"
PASSWORD_RESET_WEB_URL=
MOBILE_CONFIRM_PASSWORD_CHANGE_URL="alugacrajubar://confirm-password-change"
JWT_SECRET=
JWT_TTL=60
PASSWORD_CHANGE_TTL=30

LANDLORD_AUTO_APPROVE=true
SEED_TEST_PHONE=88999999999
SEED_HISTORY_EMAIL=seu-email@exemplo.com